<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="180dp"
    android:orientation="horizontal"
    android:gravity="bottom"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">

    <!-- TOP 2 -->

    <LinearLayout
        android:id="@+id/layoutTop2"
        android:layout_width="0dp"
        android:layout_height="140dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <!-- AVATAR -->

        <TextView
            android:id="@+id/txtAvatarTop2"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="22sp"
            android:background="@drawable/bg_avatar"/>

        <!-- MEDAL -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🥈"
            android:textSize="20sp"
            android:layout_marginTop="6dp"/>

        <!-- NAME -->

        <TextView
            android:id="@+id/txtTop2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp"/>

        <!-- XP -->

        <TextView
            android:id="@+id/txtTop2Xp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <!-- TOP 1 -->

    <LinearLayout
        android:id="@+id/layoutTop1"
        android:layout_width="0dp"
        android:layout_height="180dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:background="@drawable/bg_card_primary"
        android:elevation="12dp"
        android:scaleX="1.06"
        android:scaleY="1.06"
        android:padding="10dp">

        <!-- AVATAR -->

        <TextView
            android:id="@+id/txtAvatarTop1"
            android:layout_width="74dp"
            android:layout_height="74dp"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="28sp"
            android:background="@drawable/bg_avatar"/>

        <!-- MEDAL -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🥇"
            android:textSize="28sp"
            android:layout_marginTop="6dp"/>

        <!-- NAME -->

        <TextView
            android:id="@+id/txtTop1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="15sp"
            android:layout_marginTop="4dp"/>

        <!-- XP -->

        <TextView
            android:id="@+id/txtTop1Xp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <!-- TOP 3 -->

    <LinearLayout
        android:id="@+id/layoutTop3"
        android:layout_width="0dp"
        android:layout_height="140dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <!-- AVATAR -->

        <TextView
            android:id="@+id/txtAvatarTop3"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="22sp"
            android:background="@drawable/bg_avatar"/>

        <!-- MEDAL -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🥉"
            android:textSize="20sp"
            android:layout_marginTop="6dp"/>

        <!-- NAME -->

        <TextView
            android:id="@+id/txtTop3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp"/>

        <!-- XP -->

        <TextView
            android:id="@+id/txtTop3Xp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

</LinearLayout>