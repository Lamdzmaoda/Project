<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#081028">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp"
        android:paddingBottom="120dp">

        <!-- HEADER -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tạo bài viết"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="34sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chia sẻ kiến thức với cộng đồng"
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:layout_marginTop="6dp"/>

        <!-- CONTENT CARD -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="26dp"
            android:background="@drawable/bg_card_primary"
            android:padding="18dp">

            <EditText
                android:id="@+id/edtContent"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:background="@android:color/transparent"
                android:gravity="top"
                android:hint="Bạn đang nghĩ gì?"
                android:textColor="#FFFFFF"
                android:textColorHint="#94A3B8"
                android:textSize="17sp"
                android:padding="0dp"/>
        </LinearLayout>

        <!-- CODE CARD -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card_primary"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Code Snippet"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="16sp"/>

            <EditText
                android:id="@+id/edtCode"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="14dp"
                android:background="@android:color/transparent"
                android:gravity="top"
                android:hint="print('Hello World')"
                android:textColor="#60A5FA"
                android:textColorHint="#64748B"
                android:textSize="15sp"
                android:fontFamily="monospace"/>
        </LinearLayout>

        <!-- IMAGE PREVIEW -->

        <ImageView
            android:id="@+id/imgPreview"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card_primary"
            android:scaleType="centerCrop"
            android:visibility="gone"/>

        <!-- IMAGE BUTTONS -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp">

            <!-- ADD -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddImage"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Thêm ảnh"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2563EB"/>

            <!-- REMOVE -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRemoveImage"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="12dp"
                android:text="✕"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#DC2626"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- POST BUTTON -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPost"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="26dp"
            android:text="Đăng bài"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="17sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#3B82F6"/>
    </LinearLayout>

</ScrollView>