<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#0F172A"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- HEADER -->
    <LinearLayout
        android:id="@+id/header"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:text="✕"
            android:textSize="22sp"
            android:textColor="#FFFFFF"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <!-- 🔥 XP -->
        <TextView
            android:id="@+id/txtXP"
            android:text="XP: 0"
            android:textColor="#FACC15"
            android:layout_marginEnd="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- 🔥 LEVEL -->
        <TextView
            android:id="@+id/txtLevel"
            android:text="Lv 1"
            android:textColor="#22C55E"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

    </LinearLayout>

    <!-- PROGRESS -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_below="@id/header"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:progressTint="#A78BFA"/>

    <!-- CONTENT -->
    <ScrollView
        android:layout_below="@id/progressBar"
        android:layout_above="@id/footer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- INFO -->
            <LinearLayout
                android:id="@+id/layoutInfo"
                android:visibility="gone"
                android:background="#1E293B"
                android:padding="16dp"
                android:layout_marginBottom="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/txtInfo"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- QUESTION -->
            <LinearLayout
                android:id="@+id/layoutQuestion"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/txtQuestion"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:layout_marginBottom="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <Button
                    android:id="@+id/option1"
                    android:backgroundTint="#312E81"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"/>

                <Button
                    android:id="@+id/option2"
                    android:backgroundTint="#312E81"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"/>

                <Button
                    android:id="@+id/option3"
                    android:backgroundTint="#312E81"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"/>
            </LinearLayout>

            <!-- FILL CODE -->
            <LinearLayout
                android:id="@+id/layoutFillCode"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/txtCodeResult"
                    android:textColor="#22C55E"
                    android:background="#000000"
                    android:padding="16dp"
                    android:textSize="18sp"
                    android:layout_marginBottom="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <!-- 🔥 FIX: WRAP -->
                <LinearLayout
                    android:id="@+id/layoutWords"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    />

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <Button
                        android:id="@+id/btnCheckFill"
                        android:text="Kiểm tra"
                        android:backgroundTint="#22C55E"
                        android:textColor="#FFFFFF"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"/>

                    <Button
                        android:id="@+id/btnResetFill"
                        android:text="Reset"
                        android:backgroundTint="#EF4444"
                        android:textColor="#FFFFFF"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- FOOTER -->
    <LinearLayout
        android:id="@+id/footer"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#1E293B"
        android:layout_alignParentBottom="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/txtExplanation"
            android:textColor="#22C55E"
            android:visibility="gone"
            android:layout_marginBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/btnCheck"
            android:text="KIỂM TRA"
            android:backgroundTint="#6366F1"
            android:textColor="#FFFFFF"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/btnNext"
            android:text="TIẾP TỤC"
            android:backgroundTint="#22C55E"
            android:textColor="#FFFFFF"
            android:visibility="gone"
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>

</RelativeLayout>