<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#0F172A"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- HEADER -->
    <LinearLayout
        android:id="@+id/header"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:text="✕"
            android:textSize="22sp"
            android:textColor="#FFFFFF"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <TextView
            android:id="@+id/txtXP"
            android:text="XP: 0"
            android:textColor="#FACC15"
            android:layout_marginEnd="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/txtLevel"
            android:text="Lv 1"
            android:textColor="#22C55E"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- PROGRESS -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_below="@id/header"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:progressTint="#A78BFA"/>

    <!-- CONTENT -->
    <ScrollView
        android:layout_below="@id/progressBar"
        android:layout_above="@id/footer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- 🔥 INFO (CENTER + TO HƠN) -->
            <LinearLayout
                android:id="@+id/layoutInfo"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingTop="40dp"
                android:paddingBottom="100dp">

                <!-- TEXT CONTENT -->
                <TextView
                    android:id="@+id/txtInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:lineSpacingExtra="6dp"
                    android:gravity="start"/>

            </LinearLayout>

            <!-- QUIZ -->
            <LinearLayout
                android:id="@+id/layoutQuestion"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/txtQuestion"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:layout_marginBottom="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <LinearLayout
                    android:id="@+id/layoutAnswers"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- FILL CODE -->
            <LinearLayout
                android:id="@+id/layoutFillCode"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- CODE BLOCK -->
                <LinearLayout
                    android:orientation="vertical"
                    android:background="#111827"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- FILE NAME -->
                    <TextView
                        android:text="🐍 main.py"
                        android:textColor="#94A3B8"
                        android:textSize="14sp"
                        android:layout_marginBottom="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <!-- CODE LINE -->
                    <LinearLayout
                        android:id="@+id/layoutFillSlots"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <!-- WORD BANK -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/layoutWords"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </HorizontalScrollView>

                <!-- BUTTONS -->
                <Button
                    android:id="@+id/btnCheckFill"
                    android:text="KIỂM TRA"
                    android:backgroundTint="#6366F1"
                    android:textColor="#FFFFFF"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <Button
                    android:id="@+id/btnResetFill"
                    android:text="LÀM LẠI"
                    android:backgroundTint="#334155"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- FOOTER -->
    <LinearLayout
        android:id="@+id/footer"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#1E293B"
        android:layout_alignParentBottom="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/txtExplanation"
            android:textColor="#22C55E"
            android:visibility="gone"
            android:layout_marginBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- 🤖 AI BUTTON -->
        <LinearLayout
            android:id="@+id/btnAI"
            android:orientation="horizontal"
            android:background="#111827"
            android:padding="14dp"
            android:gravity="center_vertical"
            android:visibility="gone"
            android:layout_marginBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:text="🤖"
                android:textSize="22sp"
                android:layout_marginEnd="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:text="Cần làm rõ hơn và kèm ví dụ không nè?"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:text="🤗 Hỏi Simzy"
                    android:textColor="#60A5FA"
                    android:textSize="13sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

        </LinearLayout>

        <!-- CHECK -->
        <Button
            android:id="@+id/btnCheck"
            android:text="KIỂM TRA"
            android:backgroundTint="#6366F1"
            android:textColor="#FFFFFF"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- NEXT -->
        <Button
            android:id="@+id/btnNext"
            android:text="TIẾP TỤC"
            android:backgroundTint="#22C55E"
            android:textColor="#FFFFFF"
            android:visibility="gone"
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>

</RelativeLayout>