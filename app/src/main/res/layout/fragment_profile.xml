<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/dark_bg">

    <!-- HEADER -->

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- MORE -->

        <TextView
            android:id="@+id/btnMore"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:gravity="center"
            android:text="⋮"
            android:textColor="@android:color/white"
            android:textSize="24sp"/>

        <!-- PROFILE -->

        <LinearLayout
            android:orientation="horizontal"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- AVATAR -->

            <TextView
                android:id="@+id/txtAvatar"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:gravity="center"
                android:text="D"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="28sp"
                android:background="@drawable/bg_avatar"
                android:backgroundTint="#4338CA"/>

            <!-- INFO -->

            <LinearLayout
                android:orientation="vertical"
                android:layout_marginStart="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- USERNAME -->

                <LinearLayout
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/txtUsername"
                        android:text="dantew"
                        android:textColor="@android:color/white"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/txtVerified"
                        android:text=" ✔"
                        android:textColor="@color/blue_primary"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:layout_marginStart="4dp"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <!-- FULLNAME -->

                <TextView
                    android:id="@+id/txtFullName"
                    android:text="Dante"
                    android:textColor="#94A3B8"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <!-- STATS -->

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_marginTop="14dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/txtPosts"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:lines="2"
                        android:text="0\nBài viết"
                        android:textColor="@android:color/white"
                        android:textStyle="bold"
                        android:textSize="13sp"/>

                    <TextView
                        android:id="@+id/txtFollowers"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:lines="2"
                        android:text="0\nNgười theo dõi"
                        android:textColor="@android:color/white"
                        android:textStyle="bold"
                        android:textSize="13sp"/>

                    <TextView
                        android:id="@+id/txtFollowing"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:lines="2"
                        android:text="0\nĐang theo dõi"
                        android:textColor="@android:color/white"
                        android:textStyle="bold"
                        android:textSize="13sp"/>
                </LinearLayout>

                <!-- LEVEL CARD -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_primary"
                    android:padding="14dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginEnd="10dp">

                    <!-- TOP -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- LEVEL -->

                        <TextView
                            android:id="@+id/txtLevel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LV 1"
                            android:textColor="@android:color/white"
                            android:textStyle="bold"
                            android:textSize="16sp"/>

                        <!-- RANK -->

                        <TextView
                            android:id="@+id/txtRankTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" • Người mới"
                            android:textColor="@color/blue_primary"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:layout_marginStart="6dp"/>

                        <!-- SPACE -->

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"/>

                        <!-- STREAK -->

                        <TextView
                            android:id="@+id/txtStreak"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔥 3 ngày"
                            android:textColor="#F59E0B"
                            android:textStyle="bold"
                            android:textSize="14sp"/>
                    </LinearLayout>

                    <!-- PROGRESS -->

                    <ProgressBar
                        android:id="@+id/progressXp"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:layout_marginTop="12dp"
                        android:max="100"
                        android:progress="40"
                        android:progressTint="@color/blue_primary"
                        android:backgroundTint="#1E293B"/>

                    <!-- XP -->

                    <TextView
                        android:id="@+id/txtXpProgress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="40 / 100 XP"
                        android:textColor="#94A3B8"
                        android:textSize="12sp"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>

    <!-- ACTION -->

    <LinearLayout
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEdit"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:text="Chỉnh sửa hồ sơ"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:backgroundTint="#1E293B"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_height="48dp"
            android:text="Đăng xuất"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:backgroundTint="#2563EB"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFollow"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Theo dõi"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:backgroundTint="@color/blue_primary"
            android:visibility="gone"/>
    </LinearLayout>

    <!-- TAB -->

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#020617"
        app:tabTextColor="#9CA3AF"
        app:tabSelectedTextColor="@android:color/white"
        app:tabIndicatorColor="@color/blue_primary"
        app:tabRippleColor="@android:color/transparent"
        app:tabIndicatorFullWidth="false"/>

    <!-- POSTS -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerPost"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingBottom="80dp"/>
</LinearLayout>