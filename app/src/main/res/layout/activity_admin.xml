<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#081028">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp"
        android:paddingBottom="120dp">

        <!-- HEADER -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Admin Panel"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="34sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quản lý hệ thống học tập"
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:layout_marginTop="6dp"/>

        <!-- STATS -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp">

            <!-- USERS -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_primary"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="USERS"
                    android:textColor="#94A3B8"
                    android:textStyle="bold"
                    android:textSize="11sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2.1K"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="28sp"
                    android:layout_marginTop="10dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+120 tuần này"
                    android:textColor="#3B82F6"
                    android:textSize="12sp"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>

            <!-- COURSE -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_card_primary"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="COURSES"
                    android:textColor="#94A3B8"
                    android:textStyle="bold"
                    android:textSize="11sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="52"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="28sp"
                    android:layout_marginTop="10dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8 đang hoạt động"
                    android:textColor="#3B82F6"
                    android:textSize="12sp"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- SECTION -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quản lý"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="24sp"
            android:layout_marginTop="34dp"/>

        <!-- COURSE -->

        <LinearLayout
            android:id="@+id/btnLanguage"
            android:layout_width="match_parent"
            android:layout_height="92dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card_primary"
            android:gravity="center_vertical"
            android:padding="20dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:gravity="center"
                android:text="📚"
                android:textSize="26sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_lesson_progress"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quản lý khóa học"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="20sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Course, chapter, lesson, step"
                    android:textColor="#94A3B8"
                    android:textSize="13sp"
                    android:layout_marginTop="6dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- USER -->

        <LinearLayout
            android:id="@+id/btnUsers"
            android:layout_width="match_parent"
            android:layout_height="92dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_primary"
            android:gravity="center_vertical"
            android:padding="20dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:gravity="center"
                android:text="👥"
                android:textSize="26sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_lesson_progress"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quản lý người dùng"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="20sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thông tin, XP, role"
                    android:textColor="#94A3B8"
                    android:textSize="13sp"
                    android:layout_marginTop="6dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- PREVIEW -->

        <LinearLayout
            android:id="@+id/btnPreview"
            android:layout_width="match_parent"
            android:layout_height="92dp"
            android:layout_marginTop="14dp"
            android:background="#3B82F6"
            android:gravity="center_vertical"
            android:padding="20dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:gravity="center"
                android:text="🚀"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:background="#2563EB"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Xem ứng dụng"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="20sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mở app như user thật"
                    android:textColor="#DBEAFE"
                    android:textSize="13sp"
                    android:layout_marginTop="6dp"/>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</ScrollView>