<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:orientation="horizontal"

    android:paddingStart="18dp"
    android:paddingEnd="18dp"

    android:layout_marginBottom="18dp">

    <!-- ====================================== -->
    <!-- TIMELINE -->
    <!-- ====================================== -->

    <LinearLayout
        android:layout_width="28dp"
        android:layout_height="match_parent"

        android:orientation="vertical"

        android:gravity="top|center_horizontal">

        <!-- DOT -->

        <LinearLayout
            android:id="@+id/viewDot"

            android:layout_width="14dp"
            android:layout_height="14dp"

            android:layout_marginTop="30dp"

            android:background="@drawable/bg_button_primary"

            android:elevation="6dp"/>

        <!-- LINE -->

        <View
            android:id="@+id/viewLine"

            android:layout_width="3dp"
            android:layout_height="120dp"

            android:background="#1D4ED8"/>
    </LinearLayout>

    <!-- ====================================== -->
    <!-- CARD -->
    <!-- ====================================== -->

    <LinearLayout
        android:id="@+id/layoutCard"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:layout_weight="1"

        android:orientation="horizontal"

        android:gravity="center_vertical"

        android:padding="18dp"

        android:background="@drawable/bg_card_primary"

        android:elevation="8dp">

        <!-- ================================= -->
        <!-- ICON -->
        <!-- ================================= -->

        <LinearLayout
            android:id="@+id/layoutIcon"

            android:layout_width="64dp"
            android:layout_height="64dp"

            android:gravity="center"

            android:background="@drawable/bg_lesson_progress"

            android:elevation="6dp">

            <TextView
                android:id="@+id/txtLessonIcon"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="▶"

                android:textColor="@android:color/white"

                android:textStyle="bold"

                android:textSize="22sp"/>
        </LinearLayout>

        <!-- ================================= -->
        <!-- CONTENT -->
        <!-- ================================= -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_weight="1"

            android:layout_marginStart="16dp"

            android:orientation="vertical">

            <!-- STATUS -->

            <TextView
                android:id="@+id/txtStatus"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="ĐANG HỌC"

                android:textColor="#60A5FA"

                android:textStyle="bold"

                android:textSize="11sp"

                android:background="#12203D"

                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"/>

            <!-- TITLE -->

            <TextView
                android:id="@+id/txtTitle"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Biến là gì?"

                android:textColor="@android:color/white"

                android:textStyle="bold"

                android:textSize="18sp"

                android:maxLines="2"

                android:layout_marginTop="10dp"/>

            <!-- SUB -->

            <TextView
                android:id="@+id/txtSubtitle"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="6 phút • 4 bước"

                android:textColor="#94A3B8"

                android:textSize="13sp"

                android:layout_marginTop="6dp"/>
        </LinearLayout>

        <!-- ================================= -->
        <!-- RIGHT -->
        <!-- ================================= -->

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"

            android:orientation="vertical"

            android:gravity="center_horizontal|center_vertical">

            <!-- XP -->

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:background="#1E293B"

                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <TextView
                    android:id="@+id/txtXp"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="⚡ 50 XP"

                    android:textColor="#FACC15"

                    android:textStyle="bold"

                    android:textSize="12sp"/>
            </LinearLayout>

            <!-- BUTTON -->

            <TextView
                android:id="@+id/btnStart"

                android:layout_width="92dp"
                android:layout_height="38dp"

                android:layout_marginTop="14dp"

                android:gravity="center"

                android:text="TIẾP TỤC"

                android:textColor="@android:color/white"

                android:textStyle="bold"

                android:textSize="12sp"

                android:background="@drawable/bg_button_primary"/>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>