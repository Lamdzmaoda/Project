<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:layout_marginBottom="18dp"

    android:orientation="vertical"

    android:background="@drawable/bg_card_primary"

    android:padding="20dp">

    <!-- TOP -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="horizontal"

        android:gravity="center_vertical">

        <!-- TIMELINE -->

        <LinearLayout
            android:layout_width="42dp"
            android:layout_height="match_parent"

            android:orientation="vertical"

            android:gravity="center_horizontal">

            <!-- DOT -->

            <View
                android:layout_width="14dp"
                android:layout_height="14dp"

                android:background="@drawable/bg_timeline_dot"/>

            <!-- LINE -->

            <View
                android:layout_width="3dp"
                android:layout_height="90dp"

                android:layout_marginTop="4dp"

                android:background="#1E3A8A"/>
        </LinearLayout>

        <!-- CONTENT -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_weight="1"

            android:orientation="vertical"

            android:layout_marginStart="10dp">

            <!-- STATUS -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="BÀI HỌC"

                android:textColor="#64748B"

                android:textStyle="bold"

                android:textSize="12sp"/>

            <!-- TITLE -->

            <TextView
                android:id="@+id/txtLessonTitle"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="8dp"

                android:text="1. Chương trình Python đầu tiên"

                android:textColor="#FFFFFF"

                android:textStyle="bold"

                android:textSize="28sp"/>
        </LinearLayout>

        <!-- RIGHT -->

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:orientation="vertical"

            android:gravity="center_horizontal">

            <!-- ICON -->

            <LinearLayout
                android:layout_width="64dp"
                android:layout_height="64dp"

                android:gravity="center"

                android:background="@drawable/bg_button_primary">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="▶"

                    android:textColor="#FFFFFF"

                    android:textStyle="bold"

                    android:textSize="24sp"/>
            </LinearLayout>

            <!-- BUTTON -->

            <TextView
                android:id="@+id/txtAction"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="10dp"

                android:text="TIẾP TỤC"

                android:textColor="#3B82F6"

                android:textStyle="bold"

                android:textSize="13sp"/>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>