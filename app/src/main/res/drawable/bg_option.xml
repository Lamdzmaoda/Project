<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- selected -->
    <item android:state_selected="true">
        <shape>
            <solid android:color="#4338CA"/>
            <stroke android:width="2dp" android:color="#A5B4FC"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>

    <!-- default -->
    <item>
        <shape>
            <solid android:color="#2E2A5E"/>
            <stroke android:width="1dp" android:color="#3B3F7A"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>

</selector>