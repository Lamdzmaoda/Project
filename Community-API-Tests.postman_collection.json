								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"content\": \"Hello community! This is my first post about Java Spring Boot.\",\n    \"imageUrl\": \"https://example.com/image.jpg\",\n    \"codeSnippet\": \"public class HelloWorld {\\n    public static void main(String[] args) {\\n        System.out.println(\\\"Hello World!\\\");\\n    }\\n}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/community/posts",
							"host": ["{{base_url}}"],
							"path": ["api", "community", "posts"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.result && jsonData.result.id) {",
									"    pm.collectionVariables.set('post_id', jsonData.result.id);",
									"    console.log('Post ID saved: ' + jsonData.result.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					]
				},
