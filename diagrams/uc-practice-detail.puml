@startuml
skinparam dpi 120
skinparam backgroundColor #FFFFFF
skinparam defaultFontSize 11
skinparam useCaseFontSize 11
skinparam actorFontSize 12

left to right direction

actor "Người dùng" as USER
actor "Gemini AI" as AI
actor "Judge0" as JUDGE0

rectangle "AI Tutor & Chat" {
  (Chat với AI Tutor) as A1
  (Lấy lịch sử chat) as A2

  USER --> A1
  USER --> A2
  AI <-- A1
}

rectangle "Chạy code Python" {
  (Chạy code qua Judge0) as P1
  (Parse lỗi code) as P2

  USER --> P1
  JUDGE0 <-- P1
  P1 <. P2 : includes
}

@enduml
