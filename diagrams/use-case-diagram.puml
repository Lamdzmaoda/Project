@startuml
skinparam dpi 150
skinparam backgroundColor #FEFEFE
skinparam defaultFontSize 14
skinparam usecaseFontSize 12
skinparam actorFontSize 14
skinparam packageFontSize 13
skinparam packageBorderThickness 1

left to right direction
title Hệ thống Identity Service - Tổng quan

actor "Người dùng" as USER
actor "Quản trị viên" as ADMIN
actor "Google" as GOOGLE
actor "Gemini AI" as AI
actor "Judge0" as JUDGE0

rectangle "Tài khoản" as PKG1 #D6EAF8 {
  (Đăng ký / Đăng nhập)
  (Hồ sơ cá nhân)
}

rectangle "Học tập" as PKG2 #E8DAEF {
  (Học lý thuyết)
  (Luyện tập code)
  (Xem tiến độ)
}

rectangle "Cộng đồng" as PKG3 #FDEBD0 {
  (Bài viết / Bình luận)
  (Tương tác)
}

rectangle "AI & Code" as PKG4 #FADBD8 {
  (Chat AI)
  (Chạy code)
}

rectangle "Quản trị" as PKG5 #D4E6F1 {
  (Người dùng & Quyền)
  (Nội dung khóa học)
}

USER --> PKG1
USER --> PKG2
USER --> PKG3
USER --> PKG4

ADMIN --> PKG5

GOOGLE <-- PKG1
AI <-- PKG4
JUDGE0 <-- PKG4

@enduml
