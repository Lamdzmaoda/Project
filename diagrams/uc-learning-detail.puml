@startuml
skinparam dpi 120
skinparam backgroundColor #FFFFFF
skinparam defaultFontSize 11
skinparam useCaseFontSize 11
skinparam actorFontSize 12

left to right direction

actor "Người học" as USER
actor "Người tạo ND" as CREATOR
actor "Hệ thống" as SYS

rectangle "Hệ thống học tập" {
  (Quản lý ngôn ngữ) as L1
  (Quản lý chương) as L2
  (Quản lý bài học) as L3
  (Quản lý bước học) as L4
  (Ghi danh khóa học) as L5
  (Học lý thuyết) as L6
  (Làm quiz) as L7
  (Điền code) as L8
  (Xem tiến độ) as L9
  (Tự động unlock) as L10

  USER --> L5
  USER --> L6
  USER --> L7
  USER --> L8
  USER --> L9
  CREATOR --> L1
  CREATOR --> L2
  CREATOR --> L3
  CREATOR --> L4
  SYS --> L10
}

@enduml
