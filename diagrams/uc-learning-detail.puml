@startuml
skinparam dpi 120
skinparam backgroundColor #FFFFFF
skinparam defaultFontSize 11
skinparam useCaseFontSize 11
skinparam actorFontSize 12

left to right direction

actor "Người dùng" as USER
actor "Hệ thống" as SYS

rectangle "Học tập & Tiến độ" {
  (Ghi danh khóa học) as L1
  (Xem cây học tập) as L2
  (Nộp bài LEARN) as L3
  (Nộp bài code PRACTICE) as L4
  (Hoàn tất bài PRACTICE) as L5
  (Xem tiến độ học tập) as L6
  (Reset tiến độ) as L7
  (Tự động unlock chương mới) as L8

  USER --> L1
  USER --> L2
  USER --> L3
  USER --> L4
  USER --> L5
  USER --> L6
  USER --> L7
  SYS --> L8
  L4 <. L5 : includes
}

@enduml
