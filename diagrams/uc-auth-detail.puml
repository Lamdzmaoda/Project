@startuml
skinparam dpi 120
skinparam backgroundColor #FFFFFF
skinparam defaultFontSize 11
skinparam useCaseFontSize 11
skinparam actorFontSize 12

left to right direction

actor "Người dùng" as USER
actor "Quản trị viên" as ADMIN
actor "Google OAuth" as GOOGLE

rectangle "Xác thực & Người dùng" {
  (Đăng ký tài khoản) as UC1
  (Đăng nhập) as UC2
  (Đăng nhập bằng Google) as UC3
  (Refresh Token) as UC4
  (Đăng xuất) as UC5
  (Xem thông tin cá nhân) as UC6
  (Cập nhật hồ sơ) as UC7
  (Upload avatar) as UC8
  (Quản lý người dùng) as UC9
  (Quản lý Role) as UC10
  (Quản lý Permission) as UC11

  USER --> UC1
  USER --> UC2
  USER --> UC3
  USER --> UC4
  USER --> UC5
  USER --> UC6
  USER --> UC7
  USER --> UC8
  ADMIN --> UC9
  ADMIN --> UC10
  ADMIN --> UC11
  GOOGLE <-- UC3
}

@enduml
