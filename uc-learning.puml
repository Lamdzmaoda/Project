@startuml
left to right direction
actor "Người Dùng" as USER
actor "Hệ Thống" as SYS

rectangle "Học tập" {

  usecase "Ghi danh khóa học" as E1
  note right of E1
    POST /enrollment
    Input: languageName
    → Tạo Enrollment + khởi tạo
      progress (unlock chapter đầu)
  end note

  usecase "Xem cây học tập" as L1
  note right of L1
    GET /my-learning/{language}
    Trả về chapters/lessons kèm
    lockedStatus & completedStatus
  end note

  usecase "Xem tiến độ" as L2
  note right of L2
    GET /my-learning/{language}/progress
    Output: currentXp, totalXp,
    completedLessons, totalLessons, %
  end note

  usecase "Học LEARN" as P1
  note right of P1
    POST /my-learning/verify
    1. Lấy steps từ lesson
    2. User trả lời từng step
    3. So sánh với correctValue
    4. Đúng hết → completeLesson
  end note

  usecase "Nộp code PRACTICE" as P2
  note right of P2
    POST /my-learning/practice/submit
    1. Gửi code lên Judge0
    2. So sánh expectedOutput
    3. Scan ProblemConditions
    4. Lưu Submission
  end note

  usecase "Hoàn tất PRACTICE" as P3
  note right of P3
    POST /my-learning/practice/complete
    Kiểm tra ALL problems passed
    → completeLesson
  end note

  usecase "Reset tiến độ" as R1
  note right of R1
    DELETE /my-learning
    Xoá submissions + progress
    Reset enrollment về 0
  end note

  usecase "completeLesson\n(auto)" as S1
  note right of S1
    Được gọi sau verify/submit:
    • Cộng XP vào user
    • Tăng streak
    • Update enrollment %
    • Nếu đủ XP → unlock chapter tiếp
  end note
}

USER --> E1
USER --> L1
USER --> L2
USER --> P1
USER --> P2
USER --> P3
USER --> R1

P1 ..> S1 : <<include>>
P3 ..> S1 : <<include>>
S1 ..> SYS : thực hiện

@enduml
